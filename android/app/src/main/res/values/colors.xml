<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Mirrors lib/config/theme/app_colors.dart.
         RemoteViews can't read dynamic theme — these are the canonical strip colors. -->
    <color name="strip_onyx">#FF081815</color>
    <color name="strip_evergreen">#FF0C231F</color>
    <color name="strip_pine_teal">#FF134E3E</color>
    <color name="strip_deep_teal">#FF4A7C6A</color>
    <color name="strip_bright_snow">#FFF8F9F8</color>
    <color name="strip_grey_olive">#FF8B9A94</color>

    <!-- Splash screen background — matches Flutter app's onyx dark background -->
    <color name="splashBackground">#FF081815</color>

    <!-- Strip semantic tokens (used by layouts + renderer).
         Light-mode defaults (Material on-surface). values-night/colors.xml
         overrides these with the dark-mode palette. -->
    <color name="strip_text_primary">#DE000000</color>   <!-- 87% black -->
    <color name="strip_text_secondary">#8A000000</color> <!-- 54% black -->
    <color name="strip_text_muted">#8A000000</color>     <!-- 54% black -->
    <color name="strip_text_dim">#42000000</color>       <!-- 26% black — passed prayers -->
    <color name="strip_accent">#FF4A7C6A</color>         <!-- deep-teal — pill background (both modes) -->
    <color name="strip_pill_text">#FFF8F9F8</color>      <!-- always-light text on the teal pill -->
</resources>
