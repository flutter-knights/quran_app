<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/strip_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layoutDirection="locale">

    <TextView android:id="@+id/strip_date"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="12dp" android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:textColor="@color/strip_text_muted" android:textSize="13sp"
        android:fontFamily="@font/cairo_semibold" android:includeFontPadding="false"
        android:textAlignment="viewStart"
        android:maxLines="1" android:ellipsize="end" />

    <LinearLayout android:id="@+id/row_0"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:minHeight="28dp"
        android:paddingStart="12dp" android:paddingEnd="12dp">
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView android:id="@+id/cell_0_label"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/strip_cell_text" android:textSize="14sp"
                android:fontFamily="@font/cairo_semibold" android:includeFontPadding="false"
                android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/cell_0_tag"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/strip_text_primary" android:textSize="12sp"
                android:fontFamily="@font/cairo_bold" android:includeFontPadding="false"
                android:maxLines="1" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/cell_0_time"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/strip_cell_text" android:textSize="15sp"
            android:fontFamily="@font/cairo_bold" android:includeFontPadding="false"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout android:id="@+id/row_1"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:minHeight="28dp"
        android:paddingStart="12dp" android:paddingEnd="12dp">
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView android:id="@+id/cell_1_label"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/strip_cell_text" android:textSize="14sp"
                android:fontFamily="@font/cairo_semibold" android:includeFontPadding="false"
                android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/cell_1_tag"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/strip_text_primary" android:textSize="12sp"
                android:fontFamily="@font/cairo_bold" android:includeFontPadding="false"
                android:maxLines="1" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/cell_1_time"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/strip_cell_text" android:textSize="15sp"
            android:fontFamily="@font/cairo_bold" android:includeFontPadding="false"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout android:id="@+id/row_2"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:minHeight="28dp"
        android:paddingStart="12dp" android:paddingEnd="12dp">
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView android:id="@+id/cell_2_label"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/strip_cell_text" android:textSize="14sp"
                android:fontFamily="@font/cairo_semibold" android:includeFontPadding="false"
                android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/cell_2_tag"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/strip_text_primary" android:textSize="12sp"
                android:fontFamily="@font/cairo_bold" android:includeFontPadding="false"
                android:maxLines="1" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/cell_2_time"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/strip_cell_text" android:textSize="15sp"
            android:fontFamily="@font/cairo_bold" android:includeFontPadding="false"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout android:id="@+id/row_3"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:minHeight="28dp"
        android:paddingStart="12dp" android:paddingEnd="12dp">
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView android:id="@+id/cell_3_label"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/strip_cell_text" android:textSize="14sp"
                android:fontFamily="@font/cairo_semibold" android:includeFontPadding="false"
                android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/cell_3_tag"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/strip_text_primary" android:textSize="12sp"
                android:fontFamily="@font/cairo_bold" android:includeFontPadding="false"
                android:maxLines="1" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/cell_3_time"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/strip_cell_text" android:textSize="15sp"
            android:fontFamily="@font/cairo_bold" android:includeFontPadding="false"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout android:id="@+id/row_4"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:minHeight="28dp"
        android:paddingStart="12dp" android:paddingEnd="12dp">
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView android:id="@+id/cell_4_label"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/strip_cell_text" android:textSize="14sp"
                android:fontFamily="@font/cairo_semibold" android:includeFontPadding="false"
                android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/cell_4_tag"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/strip_text_primary" android:textSize="12sp"
                android:fontFamily="@font/cairo_bold" android:includeFontPadding="false"
                android:maxLines="1" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/cell_4_time"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/strip_cell_text" android:textSize="15sp"
            android:fontFamily="@font/cairo_bold" android:includeFontPadding="false"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
